# Скопируйте этот файл в .env и вставьте ключ ИИ — достаточно одного

# бесплатно: ключ с console.groq.com/keys
GROQ_API_KEY=

# Claude (платно): ключ с platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# нужен, только если ключ создан без workspace
ANTHROPIC_WORKSPACE_ID=
PORT=3000

# сайты, которым можно обращаться к серверу (через запятую)
ALLOWED_ORIGIN=https://alizhajloobekov-cmd.github.io
# сколько запросов к ИИ можно сделать с одного IP за час
RATE_LIMIT_PER_HOUR=30

# какой ИИ использовать: groq или anthropic (если не указано — тот, для которого есть ключ, Claude в приоритете)
AI_PROVIDER=
